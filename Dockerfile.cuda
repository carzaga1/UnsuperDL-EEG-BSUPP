# GPU variant of Dockerfile, for hospital workstations with an NVIDIA GPU.
# NOTE: written without access to a GPU or Docker to test against -- verify a
# real build (and a run against an actual GPU) before relying on this in
# production. torch==2.5.1's PyPI wheel bundles its own CUDA runtime libraries,
# so exact host CUDA-toolkit-version matching isn't required, but the NVIDIA
# driver on the host must still support the CUDA version torch was built against.

# ---- builder: resolves and installs dependencies into a venv ----
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04 AS builder

# git is required at build time only: edf2parquet is installed from a pinned
# GitHub commit (not PyPI) -- see pyproject.toml. python3.11 is not Ubuntu
# 22.04's default (3.10); installed explicitly and pinned for uv to target.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3.11 python3.11-venv \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /usr/local/bin/

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src/ src/
RUN uv sync --frozen --no-dev --python python3.11

# ---- runtime: no build tools, no git, no uv ----
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends python3.11 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY src/ src/
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python3.11", "-m", "bscarlos"]
